// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Currency {
  PEN
  USD
}

enum TransactionType {
  INCOME
  EXPENSE
  CARD_PAYMENT
  LOAN_PAYMENT
}

enum MonthlyPlanType {
  SAVINGS
  WANTS
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  passwordHash  String
  displayName   String
  createdAt     DateTime       @default(now())
  bankAccounts  BankAccount[]
  creditCards   CreditCard[]
  loans         Loan[]
  transactions  Transaction[]
  monthlyPlans  MonthlyPlan[]
  categories    Category[]
  fixedExpenses FixedExpense[]
}

model BankAccount {
  id            String         @id @default(cuid())
  bankName      String
  accountName   String
  currency      Currency       @default(PEN)
  balance       Decimal        @default(0)
  createdAt     DateTime       @default(now())
  transactions  Transaction[]
  fixedExpenses FixedExpense[]
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model CreditCard {
  id            String         @id @default(cuid())
  bankName      String
  cardName      String
  creditLimit   Decimal
  cutoffDay     Int // Día de corte (1-31)
  paymentDueDay Int // Día límite de pago (1-31)
  transactions  Transaction[]
  fixedExpenses FixedExpense[]
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Loan {
  id                 String  @id @default(cuid())
  lenderName         String
  principalAmount    Decimal
  annualInterestRate Decimal // Tasa anual en porcentaje (ej. 18.5 = 18.5%)
  totalInstallments  Int
  paidInstallments   Int     @default(0)
  monthlyPayment     Decimal
  paymentDay         Int // Día de pago (1-31)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Transaction {
  id             String          @id @default(cuid())
  type           TransactionType
  amount         Decimal
  date           DateTime
  category       String
  description    String
  isHistorical   Boolean         @default(false)
  bankAccountId  String?
  bankAccount    BankAccount?    @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  creditCardId   String?
  creditCard     CreditCard?     @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  fixedExpenseId String?
  fixedExpense   FixedExpense?   @relation(fields: [fixedExpenseId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([fixedExpenseId])
  @@index([bankAccountId])
  @@index([creditCardId])
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model MonthlyPlan {
  id            String          @id @default(cuid())
  name          String
  type          MonthlyPlanType
  monthlyTarget Decimal
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

enum CategoryType {
  EXPENSE
  INCOME
  BOTH
}

model Category {
  id   String       @id @default(cuid())
  name String
  type CategoryType @default(BOTH)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, name])
}

model FixedExpense {
  id            String        @id @default(cuid())
  name          String
  amount        Decimal
  dueDay        Int // Día de vencimiento (1-31)
  category      String
  active        Boolean       @default(true)
  bankAccountId String?
  bankAccount   BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  creditCardId  String?
  creditCard    CreditCard?   @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  transactions  Transaction[]
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
